{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Personal Assistant",
  "version": "0.1.0",
  "identifier": "com.tarkshy.assistant",
  "build": {
    "beforeDevCommand": "npm --prefix /Users/saumyathacker/Desktop/rag_sys run dev --workspace @assistant/desktop",
    "beforeBuildCommand": "npm --prefix /Users/saumyathacker/Desktop/rag_sys run build",
    "frontendDist": "../apps/desktop/dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "title": "AI Personal Assistant",
        "width": 1440,
        "height": 920,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
